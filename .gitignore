# Rust
target/
# Cargo.lock IS committed, as is every other lockfile: a workspace that ships a
# binary commits its lockfile, and reproducible CI wants all of them. See
# DECISIONS.md D-031.
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# TypeScript/JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
*.tsbuildinfo
dist/
pkg/

# WASM
*.wasm

# IDE
.idea/
.vscode/

# Claude Code local settings (not shared)
.claude/settings.local.json
.claude/plans/
*.swp
*.swo
*~
.DS_Store

# Generated
*.generated.*

# buf-generated proto code is committed, not ignored: ignoring it would leave
# `just gen-check` nothing to compare against. .gitattributes collapses its diffs.

# Scratch (working notes, not committed)
scratch/

# Generated API docs
docs/api/

# pytest-benchmark's storage directory
.benchmarks/

# SvelteKit build artifacts, for any app in the tree
.svelte-kit/
pagefind/

# Screenshots / Playwright
.playwright-mcp/
*.png

